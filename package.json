{
    "name": "blogf8",
    "version": "0.0.0",
    "private": true,
    "engines": {
        "node": ">=20.6.0"
    },
    "scripts": {
        "start": "node dist/server.js",
        "dev": "tsx watch src/server.ts",
        "build": "tsc",
        "typecheck": "tsc --noEmit",
        "db:migrate": "node --import tsx node_modules/sequelize-cli/lib/sequelize db:migrate",
        "db:migrate:undo": "node --import tsx node_modules/sequelize-cli/lib/sequelize db:migrate:undo",
        "db:migrate:prod": "NODE_ENV=production sequelize-cli db:migrate",
        "db:seed": "node --import tsx node_modules/sequelize-cli/lib/sequelize db:seed:all",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "dotenv": "^18.0.4",
        "express": "~4.16.1",
        "http-errors": "~1.6.3",
        "http-status-codes": "^2.3.0",
        "morgan": "~1.9.1",
        "mysql2": "^3.24.4",
        "sequelize": "^6.37.8",
        "sequelize-cli": "^6.6.5",
        "slugify": "^1.6.9"
    },
    "devDependencies": {
        "@types/express": "^4.17.25",
        "@types/http-errors": "^2.0.5",
        "@types/http-status-codes": "^1.2.0",
        "@types/morgan": "^1.9.10",
        "@types/node": "^26.6.4",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "prettier": "^3.9.9",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    }
}
