<%- include('../partial/header', { title: 'Khóa học' }) %>
<div class="page-heading">
    <h3>Khóa học</h3>
    <a href="/course/create" class="btn btn-primary">Đăng khóa học</a>
</div>

<% if (!courses.length) { %>
    <p class="empty-state">
        Chưa có khóa học nào. <a href="/course/create">Đăng khóa học</a>
    </p>
<% } %>

<div class="row g-4">
    <% courses.forEach(course => { %>
        <div class="col-sm-6 col-lg-4">
            <div class="card course-card h-100">
                <a href="/course/<%= course.id %>" class="course-thumb">
                    <% if (course.image) { %>
                        <img
                            src="<%= course.image %>"
                            class="card-img-top"
                            alt="<%= course.name %>"
                        >
                    <% } else { %>
                        <span class="course-thumb-placeholder"><%= course.name %></span>
                    <% } %>
                </a>

                <div class="card-body">
                    <h5 class="card-title">
                        <a href="/course/<%= course.id %>"><%= course.name %></a>
                    </h5>

                    <p class="card-text">
                        <%= course.description %>
                    </p>
                </div>
            </div>
        </div>
    <% }) %>
</div>
<%- include('../partial/footer') %>
