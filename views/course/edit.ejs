<%- include('../partial/header', { title: 'Sửa khóa học' }) %>
<div class="form-card">
    <h3>Sửa khóa học</h3>

    <form method="POST" action="/course/<%= course.id %>?_method=PUT">
        <div class="mb-3">
            <label for="name" class="form-label">Tên khóa học</label>
            <input type="text" class="form-control" value="<%= course.name %>" id="name" name="name" required>
        </div>

        <div class="mb-3">
            <label for="description" class="form-label">Mô tả khóa học</label>
            <textarea class="form-control" id="description" name="description" rows="3" maxlength="255"><%= course.description %></textarea>
        </div>

        <div class="mb-3">
            <label for="videoId" class="form-label">Video ID</label>
            <input type="text" class="form-control" value="<%= course.videoId %>" id="videoId" name="videoId" required>
            <div class="form-text">Lấy giá trị sau <code>?v=</code> trên URL YouTube.</div>
        </div>

        <div class="mb-3">
            <label for="level" class="form-label">Trình độ</label>
            <input type="text" class="form-control" value="<%= course.level %>" id="level" name="level">
        </div>

        <button type="submit" class="btn btn-primary">update</button>
        <a href="/me/stored/courses" class="btn btn-link">Hủy</a>
    </form>
</div>
<%- include('../partial/footer') %>
