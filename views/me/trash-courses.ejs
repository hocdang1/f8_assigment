<%- include('../partial/header', { title: 'Thùng rác' }) %>

<div class="mt-4">
    <h3>Khóa học đã xóa</h3>
    <a href="/me/stored/courses">← Khóa học của tôi</a>

    <form name="container-form" method="POST" action="/course/handle-form-actions">
        <div class="mt-4 d-flex align-items-center">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="checkbox-all">
                <label class="form-check-label" for="checkbox-all">Chọn tất cả</label>
            </div>

            <select class="form-select form-select-sm checkbox-select-all-options" name="action" required>
                <option value="">-- Hành động --</option>
                <option value="restore">Khôi phục</option>
                <option value="forceDelete">Xóa vĩnh viễn</option>
            </select>

            <button type="submit" class="btn btn-primary btn-sm check-all-submit-btn" disabled>Thực hiện</button>
        </div>

    <table class="table mt-4">
        <thead>
            <tr>
                <th scope="col"></th>
                <th scope="col">ID <%- sortable('id', _sort) %></th>
                <th scope="col">Tên khóa học <%- sortable('name', _sort) %></th>
                <th scope="col">Trình độ <%- sortable('level', _sort) %></th>
                <th scope="col" colspan="2">Thời gian xóa <%- sortable('deletedAt', _sort) %></th>
            </tr>
        </thead>
        <tbody>
            <% if (courses.length === 0) { %>
                <tr>
                    <td colspan="6" class="text-center">Thùng rác trống.</td>
                </tr>
            <% } %>

            <% courses.forEach((course, index) => { %>
                <tr>
                    <td>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="courseIds" value="<%= course.id %>">
                        </div>
                    </td>
                    <th scope="row"><%= course.id %></th>
                    <td><%= course.name %></td>
                    <td><%= course.level %></td>
                    <td><%= new Date(course.deletedAt).toLocaleString('vi-VN') %></td>
                    <td>
                        <button type="button" class="btn btn-link btn-restore" data-id="<%= course.id %>">Khôi phục</button>
                        <button type="button" class="btn btn-link text-danger"
                                data-bs-toggle="modal"
                                data-bs-target="#force-delete-modal"
                                data-id="<%= course.id %>"
                                data-name="<%= course.name %>">
                            Xóa vĩnh viễn
                        </button>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>
    </form>
</div>

<!-- xác nhận xoá vv -->
<div class="modal fade" id="force-delete-modal" tabindex="-1" aria-labelledby="force-delete-title" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="force-delete-title">Xóa vĩnh viễn?</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                Khóa học <strong id="force-delete-name"></strong> sẽ bị xóa vĩnh viễn và không thể khôi phục.
            </div>
            <div class="modal-footer">
                <button type="button" id="btn-force-delete" class="btn btn-danger">Xóa vĩnh viễn</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
            </div>
        </div>
    </div>
</div>

<form name="force-delete-form" method="POST"></form>
<form name="restore-form" method="POST"></form>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        let courseId;
        const deleteForm = document.forms['force-delete-form'];
        const modal = document.getElementById('force-delete-modal');

        modal.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            courseId = button.getAttribute('data-id');
            document.getElementById('force-delete-name').textContent = button.getAttribute('data-name');
        });

        document.getElementById('btn-force-delete').addEventListener('click', function () {
            deleteForm.action = '/course/' + courseId + '/force?_method=DELETE';
            deleteForm.submit();
        });

        // Khôi phục từng ô
        const restoreForm = document.forms['restore-form'];
        document.querySelectorAll('.btn-restore').forEach((button) => {
            button.addEventListener('click', function () {
                restoreForm.action = '/course/' + button.getAttribute('data-id') + '/restore?_method=PATCH';
                restoreForm.submit();
            });
        });
    });
</script>

<script src="/javascripts/form-actions.js"></script>

<%- include('../partial/footer') %>
